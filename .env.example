# MEGATRON — copy to .env and fill values. Never commit .env.
# Only set the providers you actually use; research runs without broker keys.

# --- Alpaca (trading + market data) --------------------------------
# Trading API keys (paper keys and live keys are different accounts).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# live | paper
ALPACA_MODE=paper
# Hard cap on a single order in USD. 0 disables the cap.
ALPACA_MAX_NOTIONAL=500

# --- Market / fundamentals data -----------------------------------
FINANCIAL_DATASETS_API_KEY=

# --- LLM providers (set the one you use) --------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Solana / Jupiter (MEGACRYPTO) --------------------------------
JUPITER_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WALLET_ADDRESS=
SOLANA_PRIVATE_KEY=
# Extra gate for the gated swap; keep false unless you mean it.
MEGATRON_LIVE_EXECUTION=false
